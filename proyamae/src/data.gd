# ── 수집 ───────────────────────────────────────────────────────────────────
# 팩 하나에서 나올 확률. **합이 1이어야 합니다.**
#
# **등급이 아니라 종합(OV) 구간으로 뽑습니다.** 등급이 EX·NORMAL 두 가지뿐이라
# 등급으로 뽑으면 NORMAL 하나가 98%가 되어, 8천 장에서 아무거나 나오는 것과
# 같아집니다. 구간으로 나누면 등급을 안 보여 줘도 "가끔 좋은 게 나온다"가
# 그대로 남습니다. 앞의 수가 그 구간의 **최소 OV** 입니다.
# **문턱은 OV 분포를 보고 잡습니다.** OV 를 확정 스텟의 가중 평균으로 바꾸고
# 바닥 압축을 넣으면서 분포가 옮겨졌습니다(중앙값 44 → 55 · 최대 99 → 96).
# 옛 문턱(92/84/74/63)을 그대로 두면 맨 위 칸이 0.28% 로 쪼그라듭니다.
# 지금 값(77/72/64/56)은 각각 상위 1.5% · 6.5% · 18.5% · 43.5% 자리입니다.
# **꼭대기 압축(`ST_SOFT`)을 만지면 OV 최대가 같이 내려가므로 여기도 다시 잡으세요.**
const PACK_ODDS := [
	[77, 0.015],   # EX
	[72, 0.050],
	[64, 0.120],
	[56, 0.250],
	[0, 0.565],
]
const PACK_COST := 1000
const PACK_SIZE := 10

# **이 값 이상이면 카드에 테두리 표시**를 답니다. 7코부터 스텟이 눈에 띄게
# 뛰므로(6코 6칸 평균 51.9 → 7코 59.0), 그 경계를 카드에서 바로 읽히게 합니다.
const COST_HIGH := 7

# 팀 편성 총 COST 상한 — 좋은 카드만 넣을 수 없게 하는 유일한 제동입니다.
# **`--deckscan` 으로 실제로 물리는지 확인하세요.** 지금 짤 수 있는 최대는
# 단일구단 245 · 단일연도 241 · **왕조 186** 입니다. 왕조는 상한에 못 닿으므로
# 그 자체가 왕조의 손해이고, 제일 큰 팀컬러 보너스가 그 손해와 맞물립니다.
const COST_CAP := 200

# ── 리그 등급 ──────────────────────────────────────────────────────────────
# 리그는 등급으로 나뉘고 **위로 갈수록 상대가 셉니다.** 상대의 세기는 내 로스터가
# 아니라 **등급**이 정합니다 — 내 팀에 맞춰 따라오면 아무리 카드를 모아도 늘
# 같은 난이도라 올라갈 이유가 없어집니다.
# **등급 OV 는 카드 분포를 보고 잡습니다.** 예전 값(44/55/66/77/88)은 OV 중앙값이
# 44 이던 시절의 것입니다. OV 를 확정 스텟의 가중 평균으로 바꾸고 꼭대기·바닥을
# 눌러(`ST_SOFT`·`ST_FLOOR`) 분포가 38~89(중앙 55)로 좁아졌습니다. 옛 값 그대로면
# 최고 등급이 너무 높아집니다 — 제일 약한 왕조(롯데 2003)가
# 성장을 다 부어도 **9.7등**이었습니다. 지금은 최고 등급 79 에서 2.9등입니다.
const TIERS := [
	{"name": "루키 리그", "ov": 51},
	{"name": "퓨처스 리그", "ov": 58},
	{"name": "KBO 리그", "ov": 65},
	{"name": "아시아 리그", "ov": 72},
	{"name": "월드 시리즈", "ov": 79},
]
const PROMOTE_TOP := 2      # 상위 몇 팀이 승격하는가
const RELEGATE_BOTTOM := 2  # 하위 몇 팀이 강등되는가

func tier_name(t: int) -> String:
	return str(TIERS[clampi(t, 0, TIERS.size() - 1)]["name"])

func tier_ov(t: int) -> int:

	return int(TIERS[clampi(t, 0, TIERS.size() - 1)]["ov"])
# ── 유학 ───────────────────────────────────────────────────────────────────
# 카드를 지역으로 보내 영구히 스텟을 올립니다. **COST 는 오르지 않습니다** —
# COST 상한 안에서 팀을 더 세게 만드는 유일한 길이고, 그래서 리그를 올라갈
# 이유가 됩니다. 여기에 COST 를 붙이면 유학의 존재 이유가 사라집니다.
#
# **한 카드는 평생 한 번만 갑니다. 한 지역은 스텟 하나만 올립니다.**
# 여러 번 보낼 수 있으면 한 장에 무한히 부어서 오더가 카드 한 장짜리가 되고,
# 한 지역이 여러 스텟을 올리면 "어디로 보낼까"가 아니라 "제일 많이 주는 곳"
# 하나로 굳습니다. 한 번뿐이라서 **무엇을 포기하느냐**가 선택이 됩니다.
#
# **리그를 올리는 보상은 크기가 아니라 선택지입니다.** 올려 주는 양(`AB_UP`)은
# 어디를 가든 같고, 위로 갈수록 **경기에서 더 중요한 스텟**의 지역이 열립니다
# (번트·주력 → 수비 → 정신력 → 교타 → 장타 / 체력·구속 → 변화구 → 정신력 →
# 제구 → 구위). 여섯 갈래가 각각 여섯 스텟을 하나씩 맡습니다.
# 여기에 등급별로 다른 상승치를 주지 마세요 — 그러면 낮은 등급 유학이 그냥
# 열등한 물건이 되어, 등급을 올릴 이유가 "선택지"가 아니라 "수치"로 바뀝니다.
#
# `kind` 로 타자용·투수용이 갈립니다. `DB.find` 는 카드에 없는 스텟을 그냥
# 건너뛰므로, 갈래를 안 나누면 **타자를 구위 유학에 보내고 코인만 날립니다.**
#
# 여섯 스텟이 전부 경기에 닿습니다 — 번트는 `K_LEGS`·`K_PUSH`(출루·밀어내기),
# 투수 정신력은 `_probs` 의 승부처 맞대결입니다. **경기가 안 보는 스텟을 유학지로
# 만들지 마세요**: 카드에 숫자는 오르는데 이기는 데는 아무 도움이 안 됩니다.
#
# `days` 는 **경기 수**입니다. 유학 중인 카드는 오더에 못 넣습니다. 코인만 내고
# 즉시 세지면 그냥 상점이라, 시즌 도중에 보낼지 끝나고 보낼지가 선택이 됩니다.
const AB_UP := 12   # 유학 하나가 올려 주는 양 — **지역마다 같습니다**
const ABROAD := [
	# 타자 — 번트·주력 → 수비 → 정신력 → 교타 → 장타
	{"name": "대만", "kind": "hitter", "tier": 0, "days": 6, "coin": 1500, "stat": "bunt"},
	{"name": "괌", "kind": "hitter", "tier": 0, "days": 6, "coin": 1500, "stat": "speed"},
	{"name": "호주", "kind": "hitter", "tier": 1, "days": 8, "coin": 2500, "stat": "defense"},
	{"name": "네덜란드", "kind": "hitter", "tier": 2, "days": 10, "coin": 4000, "stat": "mental"},
	{"name": "일본", "kind": "hitter", "tier": 3, "days": 12, "coin": 6000, "stat": "contact"},
	{"name": "도미니카", "kind": "hitter", "tier": 4, "days": 15, "coin": 9000, "stat": "power"},
	# 투수 — 체력·구속 → 변화구 → 정신력 → 제구 → 구위
	{"name": "캐나다", "kind": "pitcher", "tier": 0, "days": 6, "coin": 1500, "stat": "stamina"},
	{"name": "베네수엘라", "kind": "pitcher", "tier": 0, "days": 6, "coin": 1500, "stat": "velo"},
	{"name": "이탈리아", "kind": "pitcher", "tier": 1, "days": 8, "coin": 2500, "stat": "breaking"},
	{"name": "쿠바", "kind": "pitcher", "tier": 2, "days": 10, "coin": 4000, "stat": "mental"},
	{"name": "멕시코", "kind": "pitcher", "tier": 3, "days": 12, "coin": 6000, "stat": "control"},
	{"name": "미국", "kind": "pitcher", "tier": 4, "days": 15, "coin": 9000, "stat": "stuff"},
]

func abroad_up(r: int) -> Dictionary:
	# 화면·저장·경기가 **한 표만** 보게 하는 통로입니다.
	if r < 0 or r >= ABROAD.size():
		return {}
	return {str(ABROAD[r]["stat"]): AB_UP}

func abroad_for(kind: String) -> Array:
	# 그 갈래가 갈 수 있는 지역 번호 — `ABROAD` 에 적힌 등급 순서 그대로입니다.
	# **화면과 클릭과 키가 이 목록 하나를 같이 봅니다.**
	var out: Array = []
	for i in range(ABROAD.size()):
		if str(ABROAD[i]["kind"]) == kind:
			out.append(i)
	return out


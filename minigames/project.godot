; 미니게임 모음 (Godot 4) — 젤리팝 · 스카이 어설트 · 월드 러너
;
; 에디터로 열지 않고 손으로 쓴 파일입니다. 고도가 열 때 형식을 정규화할 수 있습니다.

config_version=5

[application]

config/name="미니게임"
run/main_scene="res://main.tscn"
config/icon="res://art/jelly/hub_icon.png"
; 로딩 화면 — Godot 로고 대신. 그림 위아래 색이 달라 바탕색으로는 이음매가 보여 화면을 덮게(cover = 4) 둔다
boot_splash/image="res://art/jelly/hub_splash.png"
boot_splash/bg_color=Color(0.25, 0.07, 0.67, 1)
boot_splash/stretch_mode=4
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; 가로 화면 1280×720 이 기본(11-04 사용자 결정). 게임마다 가로면 좌우 정보창, 세로로 들면 예전 세로 배치로 돈다(expand).
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

; 터치를 마우스 이벤트로 받는다. 조작 코드가 하나여야 PC 와 폰이 같이 동작한다.
pointing/emulate_mouse_from_touch=true

[rendering]

; 브라우저(WebGL2)에서는 Compatibility 렌더러만 돈다. hdr_2d 블룸은 기대하지 말고
; 빛은 가산 혼합 텍스처(src/fx.gd)로 낸다.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
; 폰 브라우저는 S3TC 를 못 읽는 경우가 있어 같이 켜 둔다.
textures/vram_compression/import_etc2_astc=true

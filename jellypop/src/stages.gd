static var _list: Array = []


static func all() -> Array:
	if _list.is_empty():
		_list = _build()
	return _list


static func count() -> int:
	return all().size()


static func get_stage(n: int) -> Dictionary:
	return all()[clampi(n, 0, count() - 1)]


## 60초 타임 어택 판 — 미션 없이 이동 제한도 없다.
static func time_attack() -> Dictionary:
	return {"id": 0, "rows": _fill(7, 7), "colors": D.COLORS, "moves": -1, "goals": []}


static func _fill(w: int, h: int) -> Array:
	var r := []
	for _y in h:
		r.append(".".repeat(w))
	return r


static func _s(rows: Array, moves: int, goals: Array, extra: Dictionary = {}) -> Dictionary:
	var st := {"rows": rows, "moves": moves, "goals": goals, "colors": 5}
	st.merge(extra, true)
	return st


static func _g(type: String, n: int = 0, color: int = -1) -> Dictionary:
	return {"type": type, "n": n, "color": color}


static func _build() -> Array:
	var L := StageGen.build_all()
	for k in L.size():
		L[k].id = k + 1
		if MOVES.has(k + 1):
			L[k].moves = MOVES[k + 1]
		if STARS.has(k + 1):
			L[k].stars = STARS[k + 1]
	return L


# ==================== 판 모양 ====================

## 판 모양 틀 — '#' 칸을 구멍으로 판다. `StageGen._mask` 가 판마다 굴려 고른다(좌우 뒤집기 포함).
## 3칸 폭 통로 틀은 넣지 마세요 — 9×9 십자에 보스가 갇혔습니다.

## 가중치 배열에서 인덱스 하나를 뽑는다
static func weighted(w: Array) -> int:
	var sum := 0.0
	for v in w:
		sum += v
	if sum <= 0.0:
		return 0
	var r := randf() * sum
	for i in w.size():
		r -= w[i]
		if r <= 0.0:
			return i
	return w.size() - 1


## 지금 시각에 해당하는 웨이브 줄
static func wave_at(t: float) -> Dictionary:
	var cur: Dictionary = WAVE[0]
	for row: Dictionary in WAVE:
		if t >= row["t"]:
			cur = row
	return cur


static func mmss(t: float) -> String:
	var s := int(max(0.0, t))
	return "%d:%02d" % [s / 60, s % 60]

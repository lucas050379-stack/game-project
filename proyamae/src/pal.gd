extends Node
# 푸야매 — 색. 오토로드(`P`)입니다.
#
# 발광은 `hdr_2d` 라 **색 값이 1.0 을 넘으면 번집니다**(`hdr()`).
# 반투명 원을 여러 겹 겹쳐서 빛을 만들지 마세요 — 층 경계가 띠로 보입니다.

# ── 바탕 ───────────────────────────────────────────────────────────────────
const BG := Color(0.055, 0.067, 0.098)        # 화면 바탕
const PANEL := Color(0.094, 0.110, 0.153)     # 패널
const PANEL_HI := Color(0.137, 0.161, 0.216)  # 밝은 패널 / 줄무늬
const LINE := Color(0.216, 0.247, 0.318)      # 구분선
const TEXT := Color(0.878, 0.902, 0.941)
const TEXT_DIM := Color(0.545, 0.588, 0.667)
const TEXT_FAINT := Color(0.376, 0.412, 0.482)

# ── 등급 ───────────────────────────────────────────────────────────────────
# 등급은 **색과 테두리 두께로** 갈립니다. 색만 다르면 도감에서 수백 장이 깔릴 때
# 구분이 안 됩니다.
# 등급은 **EX 와 NORMAL 두 가지뿐**입니다. EX 만 금색 테를 두르고 NORMAL 은
# 무채색으로 물러납니다 — 카드 세기는 등급이 아니라 COST 와 스텟 막대로 읽습니다.
const GRADE := {
	"NORMAL": Color(0.400, 0.435, 0.502),
	"EX": Color(0.949, 0.702, 0.212),
}

# ── 스텟 막대 ──────────────────────────────────────────────────────────────
# 값이 높을수록 따뜻한 쪽으로 갑니다. 스텟 종류마다 색을 나누지 마세요 —
# 여섯 칸이 무지개가 되면 "어느 칸이 높은가"가 안 읽힙니다.
const BAR_BG := Color(0.161, 0.184, 0.243)
const BAR_LOW := Color(0.353, 0.412, 0.510)
const BAR_MID := Color(0.318, 0.663, 0.749)
const BAR_HIGH := Color(0.961, 0.749, 0.286)
const BAR_TOP := Color(0.973, 0.451, 0.302)

# ── 구단 ───────────────────────────────────────────────────────────────────
# 2000~2026 사이에 실재한 구단만 있으면 됩니다. 없는 이름은 회색으로 떨어집니다.
const TEAM := {
	"삼성": Color(0.027, 0.298, 0.631),
	"두산": Color(0.075, 0.071, 0.188),
	"OB": Color(0.075, 0.071, 0.188),
	"LG": Color(0.765, 0.016, 0.322),
	"KIA": Color(0.918, 0.000, 0.161),
	"해태": Color(0.831, 0.098, 0.129),
	"롯데": Color(0.016, 0.118, 0.259),
	"한화": Color(1.000, 0.400, 0.000),
	"SK": Color(0.808, 0.055, 0.176),
	"SSG": Color(0.808, 0.055, 0.176),
	"현대": Color(0.043, 0.310, 0.573),
	"우리": Color(0.341, 0.020, 0.086),
	"서울": Color(0.341, 0.020, 0.086),
	"넥센": Color(0.341, 0.020, 0.086),
	"키움": Color(0.341, 0.020, 0.086),
	"NC": Color(0.192, 0.322, 0.533),
	"KT": Color(0.086, 0.086, 0.094),
	"쌍방울": Color(0.086, 0.322, 0.243),
}
const TEAM_FALLBACK := Color(0.302, 0.333, 0.400)

# 경고 — COST 초과처럼 "이대로는 안 된다"를 알리는 색입니다.
# **등급 색을 빌려 쓰지 마세요.** 등급이 바뀌면 화면이 통째로 깨집니다
# (실제로 LEGENDS 를 없앴다가 게임이 안 떴습니다).
const WARN := Color(0.937, 0.325, 0.263)

func team(name: String) -> Color:
	return TEAM.get(name, TEAM_FALLBACK)

func grade(g: String) -> Color:
	return GRADE.get(g, GRADE["NORMAL"])

func bar(v: int) -> Color:
	# 스텟 값 → 막대 색. 구간을 자르지 않고 섞어야 90과 89가 같은 색이 됩니다.
	# 99 위(보너스로 오른 값)는 최고색 그대로 둡니다 — 색을 130 까지 늘려 펴면
	# 99 짜리 카드가 덜 세 보여서, 카드 자체의 세기를 읽기 어려워집니다.
	if v >= 85:
		return BAR_HIGH.lerp(BAR_TOP, clampf((v - 85) / 14.0, 0.0, 1.0))
	if v >= 60:
		return BAR_MID.lerp(BAR_HIGH, clampf((v - 60) / 25.0, 0.0, 1.0))
	return BAR_LOW.lerp(BAR_MID, clampf((v - 20) / 40.0, 0.0, 1.0))

func hdr(c: Color, k: float) -> Color:
	# 밝기만 올립니다. **알파는 건드리지 마세요** — 페이드는 `a()` 로 하세요.
	# 여기서 알파까지 줄이면 색만 검게 남아 검은 자국이 됩니다.
	return Color(c.r * k, c.g * k, c.b * k, c.a)

func a(c: Color, alpha: float) -> Color:
	return Color(c.r, c.g, c.b, alpha)

# 프야매 — 수치는 전부 여기 모읍니다. 오토로드(`D`)입니다.
#
# 변환 가중치(원본 기록 → 6스텟)만 예외로 `tools/convert.gd` 에 있습니다.
# 그건 게임의 수치가 아니라 도구의 수치입니다.

# ── 카드 스텟 ──────────────────────────────────────────────────────────────
# 순서가 곧 카드에 그려지는 순서입니다. 첨부한 프야매 카드와 같은 차례입니다.

# 스텟 천장. **카드 자체는 99 까지**입니다(실제 기록을 환산한 값 — `convert.gd` 의
# `_finish_stat` 이 거기서 자릅니다). 여기 130 은 **유학·스킬블록·구종·팀컬러가
# 얹힌 뒤**의 천장입니다 — 99 로 두면 잘 키운 카드일수록 보너스가 통째로 잘려서
# "키워도 안 오르는" 상태가 됩니다.
const STAT_MAX := 130

const HIT_ST := ["contact", "power", "speed", "bunt", "defense", "mental"]
const PIT_ST := ["stamina", "velo", "stuff", "breaking", "control", "mental"]

const ST_NAME := {
	"contact": "교타력", "power": "장타력", "speed": "주력",
	"bunt": "번트", "defense": "수비력", "mental": "정신력",
	"stamina": "체력", "velo": "구속", "stuff": "구위",
	"breaking": "변화구", "control": "제구력",
}

func stats_of(kind: String) -> Array:
	return PIT_ST if kind == "pitcher" else HIT_ST


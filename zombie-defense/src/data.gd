## 가중치 배열에서 인덱스 하나를 뽑는다
static func weighted(w: Array) -> int:
	var sum := 0.0
	for v in w:
		sum += v
	if sum <= 0.0:
		return 0
	var r := randf() * sum
	for i in w.size():
		r -= w[i]
		if r <= 0.0:
			return i
	return w.size() - 1


## 지금 쓸 웨이브 줄. **라운드 번호를 보지 않는다** — 진행도만 본다.
##
## 어느 라운드든 0번 줄(기본 종 하나)에서 시작해 끝에서 마지막 줄에 닿는다. 무기가 매
## 라운드 초기화되므로 시작이 늘 똑같이 순해야 하고, 라운드 사이의 차이는 티어가 낸다.
##
## 진행도를 그대로 쓰지 않고 **1.15제곱**으로 살짝 눕힌다. 선형이면 판의 절반을 마지막
## 줄에서 보내는데 그때는 무기가 아직 안 갖춰져 있고, 반대로 너무 눕히면 판의 앞부분이
## 통째로 0~1번 줄이 되어 **아무 일도 일어나지 않는다.**
##
## > **1.6 이던 것을 1.15 로 내렸다.** 1.6 에서는 0번 줄(초당 1.9마리, 기본 종 하나)만
## > 진행도 25%까지 갔다 — 5분짜리 라운드면 **첫 76초가 좀비 몇 마리**였고, 그 뒤 1번
## > 줄까지 합치면 2분이 그랬다. "라운드 시작 1~3분이 너무 쉽다"가 여기서 나왔다.
## > 마지막 줄의 내용은 그대로이므로 **판의 꼭대기는 안 변하고 바닥만 올라간다.**
##
##   진행도       10%   25%   50%   75%   90%   100%
##   줄 번호      0     1     4     6     7     8
##   (예전 1.6)   0     1     2     5     7     8
static func wave_at(t: float, round_no: int) -> Dictionary:
	var prog := clampf(t / maxf(1.0, round_time(round_no)), 0.0, 0.999)
	return WAVE[clampi(int(pow(prog, 1.15) * float(WAVE.size())), 0, WAVE.size() - 1)]


static func mmss(t: float) -> String:
	var s := int(max(0.0, t))
	return "%d:%02d" % [s / 60, s % 60]

; 젤리팝 (Godot 4)
;
; 에디터로 열지 않고 손으로 쓴 파일입니다. 고도가 열 때 형식을 정규화할 수 있습니다.

config_version=5

[application]

config/name="젤리팝"
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; 세로 화면. 폰 브라우저가 기준이고 PC 브라우저도 같은 비율로 뜬다.
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

; 터치를 마우스 이벤트로 받는다. 조작 코드가 하나여야 PC 와 폰이 같이 동작한다.
pointing/emulate_mouse_from_touch=true

[rendering]

; 브라우저(WebGL2)에서는 Compatibility 렌더러만 돈다. hdr_2d 블룸은 기대하지 말고
; 빛은 가산 혼합 텍스처(src/fx.gd)로 낸다.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
; 폰 브라우저는 S3TC 를 못 읽는 경우가 있어 같이 켜 둔다.
textures/vram_compression/import_etc2_astc=true

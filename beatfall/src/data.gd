const WARP_DEPTH := 22.0        ## 흔들림 깊이(ms). 이 값이 곧 음이탈의 세기다
const WARP_DUCK_DB := -7.0      ## 볼륨이 주저앉는 양

## 키음([Keys])이 켜져 있을 때 음이탈에 곱하는 값.
## **둘 다 세게 걸면 서로 잡아먹는다** — 키음이 켜지면 틀린 자리에서 소리가

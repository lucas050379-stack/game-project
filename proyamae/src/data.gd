extends Node
# 프야매 — 수치는 전부 여기 모읍니다. 오토로드(`D`)입니다.
#
# 변환 가중치(원본 기록 → 6스텟)만 예외로 `tools/convert.gd` 에 있습니다.
# 그건 게임의 수치가 아니라 도구의 수치입니다.

# ── 카드 스텟 ──────────────────────────────────────────────────────────────
# 순서가 곧 카드에 그려지는 순서입니다. 첨부한 프야매 카드와 같은 차례입니다.

# 스텟 천장. **카드 자체는 99 까지**입니다(실제 기록을 환산한 값 — `convert.gd` 의
# `_finish_stat` 이 거기서 자릅니다). 여기 130 은 **유학·스킬블록·구종·팀컬러가
# 얹힌 뒤**의 천장입니다 — 99 로 두면 잘 키운 카드일수록 보너스가 통째로 잘려서
# "키워도 안 오르는" 상태가 됩니다.
const STAT_MAX := 130

const HIT_ST := ["contact", "power", "speed", "bunt", "defense", "mental"]
const PIT_ST := ["stamina", "velo", "stuff", "breaking", "control", "mental"]

const ST_NAME := {
	"contact": "교타력", "power": "장타력", "speed": "주력",
	"bunt": "번트", "defense": "수비력", "mental": "정신력",
	"stamina": "체력", "velo": "구속", "stuff": "구위",
	"breaking": "변화구", "control": "제구력",
}

func stats_of(kind: String) -> Array:
	return PIT_ST if kind == "pitcher" else HIT_ST

# ── 포지션 ─────────────────────────────────────────────────────────────────
# KBO 기록실의 수비 표가 주는 이름 그대로 씁니다(변환기가 넘겨줍니다).

const POS := ["포수", "1루수", "2루수", "3루수", "유격수", "좌익수", "중견수", "우익수", "지명타자"]
# 화면에 찍히는 포지션 이름. **한글로 씁니다** — 카드에 3B·CF 가 섞여 있으면
# 투수의 선발·중계·마무리와 표기 언어가 갈려서 한 화면에서 따로 놉니다.
# 투수는 `pos` 가 이미 한글(선발·중계·셋업·마무리)이라 그대로 통과합니다.
# **표기를 바꾸려면 여기만 고치세요** — 카드·목록·큰 화면이 다 이 표를 봅니다.
const POS_SHORT := {
	"포수": "포수", "1루수": "1루수", "2루수": "2루수", "3루수": "3루수", "유격수": "유격수",
	"좌익수": "좌익수", "중견수": "중견수", "우익수": "우익수", "지명타자": "지명타자", "외야수": "외야수",
}
# 주 포지션이 아닌 자리에 세우면 수비력이 깎입니다. 같은 계열이면 덜 깎입니다.
const POS_GROUP := {
	"포수": "C", "1루수": "IF", "2루수": "IF", "3루수": "IF", "유격수": "IF",
	"좌익수": "OF", "중견수": "OF", "우익수": "OF", "외야수": "OF", "지명타자": "DH",
}
const OUT_OF_POS := 12      # 계열이 다른 자리
const OUT_OF_POS_NEAR := 5  # 같은 계열의 다른 자리

# ── 오더 ───────────────────────────────────────────────────────────────────
# 첨부한 오더 입력창과 같은 구성입니다.
const LINEUP := 9    # 타순
const BENCH := 5     # 벤치
const ROT := 5       # 선발 로테이션
const RELIEF := 4    # 중계
# 셋업 1 · 마무리 1 은 따로 한 칸씩입니다.

const PIT_SLOTS := ["선발", "중계", "셋업", "마무리"]

# ── 경기 시뮬레이션 ────────────────────────────────────────────────────────
# 타석 하나를 확률로 굴립니다. 기준값은 리그 평균(스텟 50) 기준이고,
# 스텟 차이가 여기서 확률을 밉니다.
#
# **한 타석의 결과는 반드시 이 표 안에서 닫혀야 합니다** — 확률 합이 1이 아니면
# 이닝이 안 끝나거나 무한히 돕니다.

const INNINGS := 9
const PA_BASE := {          # 리그 평균끼리 붙었을 때
	"so": 0.180,            # 삼진
	"bb": 0.085,            # 볼넷
	"hr": 0.028,            # 홈런
	"h3": 0.005,            # 3루타
	"h2": 0.051,            # 2루타
	"h1": 0.173,            # 단타
	# 나머지는 인플레이 아웃
}

# 스텟 1점 차가 확률을 얼마나 미는가. 여기를 키우면 카드 등급 차이가 곧바로
# 경기 결과로 나타나고, 줄이면 오더를 짜는 재미가 사라집니다.
const K_CONTACT := 0.0049   # 교타력 ↔ 구위·제구 : 안타 확률
const K_POWER := 0.0071     # 장타력 ↔ 구위      : 장타 비중
const K_EYE := 0.0039       # 교타력 ↔ 제구력    : 볼넷·삼진
const K_DEF := 0.0030       # 수비력             : 인플레이 안타 억제
const K_MENTAL := 0.0035    # 정신력             : 득점권 보정
const K_SPEED := 0.0060     # 주력               : 도루·추가 진루

# 투수 체력 — 던진 타자 수가 이 값을 넘으면 스텟이 깎이기 시작합니다.
const STAM_BASE := 12.0     # 체력 50 기준 타자 수
const STAM_PER := 0.34      # 체력 1점당 늘어나는 타자 수
const TIRE_PER_BF := 1.6    # 한계를 넘으면 타자 하나당 깎이는 스텟

# ── 수집 ───────────────────────────────────────────────────────────────────
# 팩 하나에서 나올 확률. **합이 1이어야 합니다.**
#
# **등급이 아니라 종합(OV) 구간으로 뽑습니다.** 등급이 EX·NORMAL 두 가지뿐이라
# 등급으로 뽑으면 NORMAL 하나가 98%가 되어, 8천 장에서 아무거나 나오는 것과
# 같아집니다. 구간으로 나누면 등급을 안 보여 줘도 "가끔 좋은 게 나온다"가
# 그대로 남습니다. 앞의 수가 그 구간의 **최소 OV** 입니다.
const PACK_ODDS := [
	[92, 0.015],   # EX
	[84, 0.050],
	[74, 0.120],
	[63, 0.250],
	[0, 0.565],
]
const PACK_COST := 1000
const PACK_SIZE := 10

# **이 값 이상이면 카드에 테두리 표시**를 답니다. 7코부터 스텟이 눈에 띄게
# 뛰므로(6코 6칸 평균 51.9 → 7코 59.0), 그 경계를 카드에서 바로 읽히게 합니다.
const COST_HIGH := 7

# 팀 편성 총 COST 상한 — 좋은 카드만 넣을 수 없게 하는 유일한 제동입니다.
const COST_CAP := 180

# ── 리그 등급 ──────────────────────────────────────────────────────────────
# 리그는 등급으로 나뉘고 **위로 갈수록 상대가 셉니다.** 상대의 세기는 내 로스터가
# 아니라 **등급**이 정합니다 — 내 팀에 맞춰 따라오면 아무리 카드를 모아도 늘
# 같은 난이도라 올라갈 이유가 없어집니다.
const TIERS := [
	{"name": "루키 리그", "ov": 44},
	{"name": "퓨처스 리그", "ov": 55},
	{"name": "KBO 리그", "ov": 66},
	{"name": "아시아 리그", "ov": 77},
	{"name": "월드 시리즈", "ov": 88},
]
const PROMOTE_TOP := 2      # 상위 몇 팀이 승격하는가
const RELEGATE_BOTTOM := 2  # 하위 몇 팀이 강등되는가

func tier_name(t: int) -> String:
	return str(TIERS[clampi(t, 0, TIERS.size() - 1)]["name"])

func tier_ov(t: int) -> int:
	return int(TIERS[clampi(t, 0, TIERS.size() - 1)]["ov"])

# ── 유학 ───────────────────────────────────────────────────────────────────
# 카드를 지역으로 보내 영구히 스텟을 올립니다. **COST 는 오르지 않습니다** —
# COST 상한 안에서 팀을 더 세게 만드는 유일한 길이고, 그래서 리그를 올라갈
# 이유가 됩니다. 여기에 COST 를 붙이면 유학의 존재 이유가 사라집니다.
#
# **한 카드는 한 지역에 한 번만** 갑니다. 안 그러면 한 장에 무한히 부어서
# 오더가 카드 한 장짜리가 됩니다.
#
# `tier` 는 그 지역이 열리는 리그 등급입니다 — 위로 올라갈수록 갈 곳이 늘어납니다.
# `days` 는 **경기 수**입니다. 유학 중인 카드는 오더에 못 넣습니다. 코인만 내고
# 즉시 세지면 그냥 상점이라, 시즌 도중에 보낼지 끝나고 보낼지가 선택이 됩니다.
const ABROAD := [
	{"name": "대만", "tier": 0, "days": 5, "coin": 1200,
		"up": {"bunt": 6, "speed": 4}},
	{"name": "일본", "tier": 1, "days": 8, "coin": 2600,
		"up": {"contact": 5, "control": 5, "defense": 3}},
	{"name": "호주", "tier": 2, "days": 10, "coin": 4200,
		"up": {"stamina": 6, "defense": 5, "mental": 3}},
	{"name": "도미니카", "tier": 3, "days": 12, "coin": 6800,
		"up": {"power": 7, "velo": 7, "speed": 3}},
	{"name": "미국", "tier": 4, "days": 16, "coin": 12000,
		"up": {"stuff": 6, "breaking": 6, "mental": 5, "contact": 3}},
]

# ── 팀컬러 ─────────────────────────────────────────────────────────────────
# 표와 판정은 전부 `src/color.gd`(`Col`) 에 있습니다.
# **한 번에 하나만 켭니다** — 오더 화면에서 고르고 `Sv.color_id` 에 저장합니다.

# ── 시즌 ───────────────────────────────────────────────────────────────────
# 한 시즌 = 내 팀이 치르는 경기 수. 나머지 아홉 팀도 같은 날 자기들끼리 붙어서
# 순위표가 같이 움직입니다 — 내 승패만 세면 순위가 아니라 그냥 전적입니다.
const SEASON_GAMES := 30
const LEAGUE_NAMES := ["삼성", "두산", "LG", "KIA", "롯데", "한화", "SSG", "키움", "NC"]
const MY_TEAM := "내 팀"

# 리그 팀들의 세기 — 내 타순 평균 종합에서 이만큼 떨어진 값으로 잡습니다.
# **한 팀이라도 나보다 확실히 세야** 순위 경쟁이 됩니다.
const LEAGUE_SPREAD := [8, 5, 3, 1, -1, -3, -5, -8, -12]

const COIN_WIN := 300
const COIN_LOSE := 120
const COIN_PER_RUN := 12

# 시즌이 끝나면 순위대로 줍니다. 1위부터 10위까지.

## 상점 한 줄의 레벨당 값. `power` 가 이걸 통해 `SHOP` 을 읽으므로
## 수치를 두 곳에 적어 두는 일이 없다.
static func shop_val(kind: String) -> float:
	for row: Dictionary in SHOP:
		if String(row["kind"]) == kind:
			return float(row["val"])
	return 0.0


## 다음 한 레벨을 사는 데 드는 코인. 살수록 비싸진다.
##
## **100단계를 감당하는 완만한 곡선이어야 한다.** 예전 1.55배는 6단계용이라 100단계에
## 넣으면 40 × 1.55^99 로 64비트 정수를 넘겨 버린다. 1.045배면 첫 레벨 40 → 100레벨 3,100
## 정도이고, 한 줄을 끝까지 채우는 데 드는 총액이 7만 코인 안팎이라 여러 판에 걸친 목표가 된다.
static func shop_cost(idx: int, level: int) -> int:
	var base: int = SHOP[idx]["cost"]
	return int(round(base * pow(1.045, level)))


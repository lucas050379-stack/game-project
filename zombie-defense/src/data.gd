	return MAP[(maxi(1, round_no) - 1) % MAP.size()]

# ==================== 라운드 ====================
#
# ## 이 게임의 난이도는 **한 줄의 식**이다
#
#     라운드 n 은, 모든 강화를 `req_lv(n)` 단계까지 올린 화력이면 클리어된다
#
# 1라운드는 0강, 100라운드는 전 항목 99강. 그래서 상점의 만렙이 100 이고 라운드도
# 100 이 마지막 지점이다. 이 대응이 무너지면 나머지 수치를 아무리 다듬어도 소용이
# 없으므로, **아래 함수들은 전부 이 식에서 역산한 값이다.**
#
# **양 끝은 못 박혀 있고 그 사이가 휜다**(`REQ_POW`). 예전에는 `req_lv(n) = n-1` 인
# 직선이었는데, 실제로 돌려 보니 중반이 너무 빡빡하고 후반은 그에 비해 밋밋했다 —
# 라운드가 오를수록 무거워지는 느낌이 나야 하는데 곡선이 평평했기 때문이다.
# 지금은 아래로 볼록해서 초·중반 요구가 내려가고 마지막 20라운드에 몰린다.
#
# 식이 성립하려면 라운드끼리 다른 것이 **딱 하나**여야 한다. 그래서:
#
# * 적 체력에 라운드 배율을 곱하지 않는다 (`round_hp` 를 지웠다)
# * 스폰 간격·수도 라운드마다 바꾸지 않는다 (`round_rate`/`round_burst` 를 지웠다)
# * 판 안의 시간 배율(`hp_scale`)도 **진행도**로 세므로 라운드 길이와 무관하다
#
# 라운드가 바꾸는 것은 **나오는 적의 티어 구성**뿐이다(`tier_mix`). 요구 화력이
# 오르는 통로가 하나뿐이라 검산이 쉽고, 화면에서도 색으로 바로 읽힌다.

## 마지막 라운드 지점. 상점 만렙과 **같은 수여야 한다** —
## "100라운드 = 전 항목 99강" 이 이 둘의 대응에서 나온다.
const MAX_ROUND := 100

# ==================== 난이도 ====================
#
# ## 난이도는 **곱하기 셋**이 전부다
#
# 적 체력 · 적 피해 · 코인 보상에 각각 하나씩 곱한다. **모든 라운드에 똑같이 걸리므로
# "라운드 n = 전 항목 `req_lv(n)`강" 등식은 그대로다** — 등식이 맞추는 것은 라운드끼리의
# **비율**이고, 여기 값은 그 비율 전체를 위아래로 옮길 뿐이다.
#
# > **라운드별로 난이도를 손대고 싶어질 때 여기를 쓰세요.** 라운드마다 다른 값을 주는
# > 순간 요구 화력이 오르는 통로가 둘이 되고, 그때부터 검산이 불가능해진다
# > (실제로 그렇게 만들었다가 되돌린 적이 있다 — "왜 라운드 체력 배율을 없앴나" 참고).
#
# > **경험치는 난이도를 안 탄다.** 코인만 오른다. 경험치까지 올리면 어려운 난이도에서
# > 레벨업이 빨라져 빌드가 더 빨리 완성되고, 그러면 어려운 쪽이 오히려 쉬워진다.
# > 어려움의 대가는 **코인**으로만 준다.
#
#   난이도    산책   쉬움   보통   어려움   지옥
#   적 체력   0.45   0.70   1.00   1.55    2.30
#   적 피해   0.60   0.80   1.00   1.25    1.55
#   코인      0.65   0.85   1.00   1.35    1.80
const DIFFICULTY := [
	{ "name": "산책", "hp": 0.45, "dmg": 0.60, "coin": 0.65,
	  "desc": "구경하듯 돌아다니고 싶을 때." },
	{ "name": "쉬움", "hp": 0.70, "dmg": 0.80, "coin": 0.85,
	  "desc": "손에 익히는 동안." },
	{ "name": "보통", "hp": 1.00, "dmg": 1.00, "coin": 1.00,
	  "desc": "설계 그대로의 난이도." },
	{ "name": "어려움", "hp": 1.55, "dmg": 1.25, "coin": 1.35,
	  "desc": "한 대가 아프고 적이 잘 안 죽는다." },
	{ "name": "지옥", "hp": 2.30, "dmg": 1.55, "coin": 1.80,
	  "desc": "빌드가 완성되기 전에 죽는다." },
]
## 처음 켰을 때의 난이도 ("보통")
const DIFF_DEFAULT := 2


static func diff_row() -> Dictionary:
	return DIFFICULTY[clampi(Sv.difficulty, 0, DIFFICULTY.size() - 1)]


static func diff_hp() -> float:
	return float(diff_row()["hp"])


static func diff_dmg() -> float:
	return float(diff_row()["dmg"])


static func diff_coin() -> float:
	return float(diff_row()["coin"])

## 라운드 길이 (초). 버티면 클리어.
##
## **10라운드 단위로 계단처럼 늘어난다.** 매 라운드 20초씩 늘리던 때는 10라운드에 이미
## 5분이라 초반부터 한 판이 너무 길었고, 그래서 계단으로 바꿨다.
##
##   라운드   1~10  11~20  21~30  …  61~70  71~
##   길이     480초  540초  600초  …  840초  900초
##
## > **한 라운드가 곧 뱀서의 한 판이다.** 스킬 6칸 × 6레벨 + 패시브 4칸 × 5레벨 =
## > 풀빌드에 **56장**이 든다. 3분 라운드는 레벨업이 29번뿐이라 빌드의 절반도 못 갖췄다.
## > 8분이면 **약 52번**이고, 여기에 보물상자(`CHEST_*`)가 한 번에 1~5개를 얹으므로
## > 한 라운드 안에 빌드가 완성된다 — 뱀서의 30분 한 판과 같은 곡선이다.
## >
## > **라운드 길이는 난이도 등식을 건드리지 않는다.** 판 안의 체력 배율(`hp_scale`)도
## > 웨이브 줄(`wave_at`)도 초가 아니라 **진행도**로 세기 때문에, 길이를 바꾸면 판이
## > 통째로 늘어날 뿐 모양은 그대로다. 다만 **판 끝은 조금 헐거워진다** — 적의 최종 체력
## > 배율(17배)은 그대로인데 플레이어는 카드를 더 받기 때문이다. 전체를 조이려면
## > 여기가 아니라 `HP_RAMP` 를 보세요.
static func round_time(n: int) -> float:
	return minf(900.0, 480.0 + 60.0 * floorf(float(maxi(1, n) - 1) / 10.0))


## 모든 강화를 `lv` 단계까지 올렸을 때의 **화력 배율**. 난이도 설계의 기준자다.
##
## 상점에서 화력에 관여하는 줄은 공격력(`dmg`)과 재사용 대기(`cd`) 둘뿐이고,
## 초당 피해는 그 둘의 곱이다. `SHOP` 의 `val` 을 바꾸면 이 함수도 같이 움직이므로
## **난이도를 손대지 않아도 자동으로 따라온다** — 그게 이 함수를 따로 둔 이유다.
##
##   단계   0     1     10    25    50    75    99
##   배율  1.00  1.07  1.70  2.94  5.71  10.0  17.09
static func power(lv: int) -> float:
	return power_f(float(maxi(0, lv)))


## 같은 것을 소수 단계로. `req_lv` 가 정수가 아닌 값을 내므로 필요하다.
static func power_f(lv: float) -> float:
	var l := maxf(0.0, lv)
	var d := 1.0 + shop_val("dmg") * l
	var c := maxf(CD_FLOOR, 1.0 - shop_val("cd") * l)
	return d / c


## 라운드 n 을 클리어하는 데 필요한 **강화 단계**. 이 게임의 난이도 곡선 그 자체다.
##
## 양 끝은 못 박혀 있다 — `req_lv(1) = 0`, `req_lv(100) = 99`. 그 사이를 `REQ_POW` 로
## 휘게 한다. 1.0 이면 예전의 직선(`n-1`)이고, 키울수록 **아래로 볼록**해져서
## 초·중반 요구가 내려가고 마지막 구간에 몰린다.
##
## > **실제로 돌려 보고 여기로 왔다.** 직선이던 시절엔 중반이 빡빡한데 후반은 그에 비해
## > 밋밋했다 — 라운드 100 이 라운드 40 보다 4배 무거운데 체감이 그만큼 안 났다.
## > 지금은 40라운드가 예전의 절반쯤이고 마지막 20라운드에서 2배가 된다.
##
## > **`HP_RAMP` 과 역할이 다르다.** `HP_RAMP` 은 모든 라운드를 똑같이 올리고 내리는
## > 손잡이(판 전체의 세기)이고, 이 값은 **라운드 사이의 기울기**만 바꾼다.
## > "전체가 헐겁다"면 `HP_RAMP`, "초반이 빡빡하고 후반이 밋밋하다"면 여기다.
##
##   라운드    1    10    22    40    60    80   100
##   필요 강화 0   2.1   9.0  22.3  43.3  69.0    99
##   요구 화력 1.00 1.14  1.24  2.70  4.86  8.77 17.09
const REQ_POW := 1.6

static func req_lv(n: int) -> float:
	var last := float(MAX_ROUND - 1)
	var p := clampf(float(maxi(1, n) - 1) / last, 0.0, 1.0)
	return last * pow(p, REQ_POW)


## 라운드 n 의 **요구 화력**. `tier_mix` 가 이 값에 적 체력을 맞춘다.
static func req_power(n: int) -> float:
	return power_f(req_lv(n))


## 티어(색깔 등급)별 체력 배율. **기본형이 1, 한 단계 오를 때마다 약 2.58배.**
##
## 등비의 밑은 `power(99)` 의 세제곱근이다 — 마지막 티어가 정확히 100라운드의 요구
## 화력에 닿게 하려는 것이다. 티어를 하나 더 늘리려면 밑을 다시 구해야 한다.
const TIER_MUL := [1.0, 2.576, 6.636, 17.094]

## 티어당 접촉 피해가 오르는 정도 (체력 배율의 이 제곱).
##
## **"몇 대 맞으면 죽나"가 모든 라운드에서 같아야 한다**는 조건에서 역산한 값이다.
## 라운드 n 을 `req_lv(n)`강으로 도는 플레이어의 최대 체력은 `1 + 0.03 * req_lv(n)` 배이고
## 100라운드면 3.97배다. 티어 배율은 17.094배이므로
##
##     ln(3.97) / ln(17.094) = 0.486
##
## 0.3 이던 값을 여기로 올렸다. 0.3 에서는 3티어가 2.35배로만 때려서, 체력이 4배인
## 만강 플레이어에게 **고라운드가 오히려 1.7배 안전했다** — 판이 무서워야 할 구간에서
## 맞아도 그만인 상태가 됐다. 지금은 3티어가 3.93배다.
const TIER_DMG_POW := 0.486


## 이 라운드에 섞어 낼 티어. `[낮은 티어, 높은 티어가 차지하는 비율]` 을 돌려준다.
##
## **여기가 이 게임의 난이도 전부다.** 라운드 n 의 평균 체력 배율이 `req_power(n)` 이
## 되도록 이웃한 두 티어를 섞는다 — 비율을 저렇게 푸는 이유가 그것이고, 그래서
## "라운드 n = 전 항목 `req_lv(n)` 강" 이 수식으로 성립한다.
##
##   라운드   1      10     22     40     60     71     80     100
##   요구배율 1.00   1.14   1.24   2.70   4.86   6.64   8.77   17.09
##   구성     T0     T0+T1  T0+T1  T1+T2  T1+T2  T2     T2+T3  T3
##
## 곡선을 휘면서 **색이 바뀌는 지점이 뒤로 밀렸다** — 붉은 적(T2)은 24 → 38라운드,
## 보랏빛(T3)은 58 → 71라운드부터다. 화면에서 난이도가 읽히는 방식은 그대로다.
static func tier_mix(n: int) -> Array:
	var want := req_power(n)
	var lo := 0
	while lo < TIER_MUL.size() - 2 and float(TIER_MUL[lo + 1]) < want:
		lo += 1
	var a := float(TIER_MUL[lo])
	var b := float(TIER_MUL[lo + 1])
	return [lo, clampf((want - a) / maxf(0.001, b - a), 0.0, 1.0)]


## 적 한 마리의 체력 배율 — **판 안의 시간 배율뿐이다.** 라운드 배율은 없다.
##
## 라운드마다 체력에 배수를 곱하던 것을 통째로 걷어냈다. 그 방식은 같은 좀비가 100라운드에서
## 65배 체력을 갖는다는 뜻이라 화면만 봐서는 얼마나 단단한지 알 수가 없었고, 요구 화력이
## 체력·스폰·웨이브 세 갈래로 갈라져 검산도 되지 않았다. 지금은 **티어(색)** 하나로 낸다.
##
## 시간 배율은 초가 아니라 **진행도**로 센다. 라운드 길이가 2~5분으로 다르므로 초로 세면
## 긴 라운드가 그 사실만으로 더 어려워져 위의 등식이 깨진다.
##
## > **`HP_RAMP` 이 게임 전체의 난이도 손잡이다.** 모든 라운드에 똑같이 걸리므로
## > "라운드 n = 전 항목 `req_lv(n)`강" 등식은 그대로 두고 전체를 올리고 내릴 수 있다. 등식은
## > **비율**만 맞출 뿐이라 기준점(1라운드 0강)이 헐거우면 100라운드 만강도 똑같이 헐겁다 —
## > 실제로 2.6 이던 시절 100라운드를 풀강으로 돌면 필요 화력의 11.8배가 나왔다.
##
## 눕히는 것이 중요하다. 판 앞부분은 무기 하나로 버티는 구간이라 선형으로 올리면 그때
## 벽이 되고, 정작 무기를 다 갖춘 뒷부분이 헐거워진다. 다만 **2제곱은 너무 눕는다** —
## 진행도 20%에서 배율이 1.6밖에 안 돼서 판 앞부분이 아무 저항 없이 지나갔다.
## 지금은 1.75제곱이다. 끝값(17배)은 그대로이고 앞부분만 올라온다.
##
## > **책상 계산이 광역기를 못 본다.** 필요 화력을 "초당 스폰 × 평균 체력"으로 재면
## > 광역기가 한 번에 몇 마리를 때리는지는 셀 수가 없는데, 반지름 330짜리 포스 필드는
## > 적이 수백 마리 깔린 판 후반에 한 번에 90마리 가까이 때린다. 그래서 계산상 여유가
## > 2.0배로 나와도 실제로는 훨씬 헐거웠다. 이 값을 6.2 → 16 으로 올린 것은 그 차이를
## > 메우려는 것이고, **정확한 보정은 실제 `최고 초당 피해`(클리어 화면)로 해야 한다.**
##
##   진행도  0%    20%   25%   50%   75%   100%
##   배율   1.00  1.96  2.41  5.76  10.7  17.0
const HP_RAMP := 16.0
## 시간 배율의 곡률. 낮출수록 판의 앞부분이 빨리 단단해진다 (2.0 이던 것을 내렸다).
const HP_RAMP_POW := 1.75

static func hp_scale(prog: float) -> float:
	return 1.0 + HP_RAMP * pow(clampf(prog, 0.0, 1.0), HP_RAMP_POW)


## 이 라운드에 나오는 보스 수. **어느 라운드든 최소 하나, 최대 8마리.**
##
## > **1라운드에도 반드시 하나는 나와야 한다.** 진화가 보물상자 안으로 들어간 뒤로
## > 보스가 없는 라운드는 **진화가 아예 불가능한 라운드**가 된다. 예전에는 1~2라운드를
## > 비워 뒀는데, 그러면 게임의 핵심 고리가 두 라운드 동안 한 번도 안 돌아간다.
##
## 위쪽 상한이 없으면 100라운드에서 50마리가 되어 화면이 보스로 덮인다 — 15라운드에서 닫는다.
## 보스도 티어 배율을 그대로 받으므로(`World._add_enemy`) 이 수를 더 늘릴 필요가 없다.
static func round_bosses(n: int) -> int:
	return mini(8, 1 + (maxi(1, n) - 1) / 2)


## 라운드에서 번 경험치 중 코인으로 바뀌는 비율.
## 클리어 순간 필드에 남은 젬까지 전부 흡수하므로(`World.absorb_gems`) 이 값이 곧
## "얼마나 잘 쓸어 담았는가"에 대한 보상이 된다.
const XP_TO_COIN := 0.30

## 클리어 보상 코인 — 기본 + 라운드 + **그 라운드에서 번 경험치의 일부**
static func round_coins(n: int, xp_got: int) -> int:
	return 20 + 12 * maxi(1, n) + int(float(maxi(0, xp_got)) * XP_TO_COIN)


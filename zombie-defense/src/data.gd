static func wave_at(t: float, round_no: int) -> Dictionary:
	var prog := clampf(t / maxf(1.0, round_time(round_no)), 0.0, 0.999)
	return WAVE[clampi(int(pow(prog, 1.15) * float(WAVE.size())), 0, WAVE.size() - 1)]


static func mmss(t: float) -> String:
	var s := int(max(0.0, t))
	return "%d:%02d" % [s / 60, s % 60]

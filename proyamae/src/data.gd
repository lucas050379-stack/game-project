# 등급은 **EX 와 NORMAL 두 가지뿐**입니다. NORMAL 은 카드에 아무 표기도 안
# 합니다 — 대부분이 NORMAL 이라 표기해 봐야 정보가 아니라 소음입니다.
const GRADE_EX := "EX"
const GRADE_NORMAL := "NORMAL"

func grade_rank(g: String) -> int:
	return 1 if g == GRADE_EX else 0

func show_grade(g: String) -> bool:
	return g == GRADE_EX
